---
import '../styles/global.css';
import { brand, CALENDLY_URL } from '../lib/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: brand.name,
  description,
  areaServed: 'România',
  founder: brand.owner,
  knowsAbout: ['identitate vizuală', 'branding', 'graphic design', 'design pentru cursuri'],
  url: 'https://sgdesign.ro',
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta name="theme-color" content="#16161a" />
    <script is:inline>
      // Confirm JS is active before paint so reveal-hidden states apply without
      // a flash. Failsafe: if the reveal engine never runs (e.g. script fails),
      // drop the gate after 2.6s so content is never permanently hidden.
      document.documentElement.classList.add('has-js');
      setTimeout(function () {
        if (!window.__revealReady) document.documentElement.classList.remove('has-js');
      }, 2600);
    </script>
    <link rel="preconnect" href="https://assets.calendly.com" crossorigin />
    <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-2 focus:text-canvas"
      >Sari la conținut</a
    >
    <slot />

    <script is:inline define:vars={{ CALENDLY_URL }}>
      // Calendly popup with graceful <a href> fallback
      document.addEventListener('click', (e) => {
        const el = e.target.closest('[data-calendly]');
        if (!el) return;
        if (window.Calendly && typeof window.Calendly.initPopupWidget === 'function') {
          e.preventDefault();
          window.Calendly.initPopupWidget({ url: CALENDLY_URL });
        }
        // else: let the default <a href> open Calendly in a new tab
      });
    </script>

    <script src="https://assets.calendly.com/assets/external/widget.js" async></script>

    <script>
      // ---- Scroll reveal (scroll-checked: cannot leave hidden stragglers) --
      window.__revealReady = true;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let pending = Array.from(document.querySelectorAll('.reveal, .reveal-img'));

      function show(el) {
        el.classList.add('is-visible');
        el.querySelectorAll('[data-reveal-child]').forEach((kid, i) => {
          kid.style.transitionDelay = `${i * 70}ms`;
          kid.classList.add('is-visible');
        });
      }

      if (reduce) {
        document.documentElement.classList.remove('has-js');
        pending = [];
      } else {
        const check = () => {
          const trigger = window.innerHeight * 0.9;
          pending = pending.filter((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < trigger && r.bottom > 0) {
              show(el);
              return false;
            }
            return true;
          });
          if (!pending.length) {
            window.removeEventListener('scroll', onScrollCheck);
          }
        };
        let ticking = false;
        const onScrollCheck = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            check();
          });
        };
        check();
        window.addEventListener('scroll', onScrollCheck, { passive: true });
        window.addEventListener('resize', check, { passive: true });
        window.addEventListener('load', check);
      }

      // ---- Header scrolled state ------------------------------------------
      const header = document.querySelector('[data-header]');
      if (header) {
        const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // ---- Magnetic primary buttons (subtle) ------------------------------
      if (!reduce && window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll('.btn').forEach((btn) => {
          btn.addEventListener('mousemove', (e) => {
            const r = btn.getBoundingClientRect();
            const x = (e.clientX - r.left - r.width / 2) * 0.18;
            const y = (e.clientY - r.top - r.height / 2) * 0.28;
            btn.style.transform = `translate(${x}px, ${y - 2}px)`;
          });
          btn.addEventListener('mouseleave', () => {
            btn.style.transform = '';
          });
        });
      }

      // ---- Hero studio light: drifts toward the cursor (desktop only) ------
      if (!reduce && window.matchMedia('(pointer: fine)').matches) {
        const lights = Array.from(document.querySelectorAll('[data-studio-light]'));
        if (lights.length) {
          lights.forEach((el) => el.classList.add('studio-light--cursor'));
          const hero = lights[0].closest('section');
          let inView = true;
          if (hero && 'IntersectionObserver' in window) {
            new IntersectionObserver(
              ([e]) => { inView = e.isIntersecting; },
              { threshold: 0 }
            ).observe(hero);
          }
          let raf = 0;
          window.addEventListener(
            'pointermove',
            (e) => {
              if (!inView || raf) return;
              raf = requestAnimationFrame(() => {
                raf = 0;
                const dx = e.clientX / window.innerWidth - 0.5;
                const dy = e.clientY / window.innerHeight - 0.5;
                lights.forEach((el) => {
                  const f = parseFloat(el.getAttribute('data-studio-light')) || 1;
                  el.style.setProperty('--lx', (dx * 40 * f).toFixed(1) + 'px');
                  el.style.setProperty('--ly', (dy * 40 * f).toFixed(1) + 'px');
                });
              });
            },
            { passive: true }
          );
        }
      }

      // ---- Mobile nav ------------------------------------------------------
      const navToggle = document.querySelector('[data-nav-toggle]');
      const navMenu = document.querySelector('[data-nav-menu]');
      if (navToggle && navMenu) {
        const setOpen = (open) => {
          navMenu.toggleAttribute('data-open', open);
          navToggle.toggleAttribute('data-open', open);
          navToggle.setAttribute('aria-expanded', String(open));
          navToggle.setAttribute('aria-label', open ? 'Închide meniul' : 'Deschide meniul');
          document.body.style.overflow = open ? 'hidden' : '';
        };
        navToggle.addEventListener('click', () => setOpen(!navMenu.hasAttribute('data-open')));
        navMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
        // close if resized up to desktop
        window.matchMedia('(min-width: 768px)').addEventListener('change', (m) => {
          if (m.matches) setOpen(false);
        });
      }
    </script>
  </body>
</html>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .focus\:not-sr-only:focus {
    position: fixed;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>
