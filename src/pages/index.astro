---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import VslPlayer from '../components/VslPlayer.astro';
import Marquee from '../components/Marquee.astro';
import Portfolio from '../components/Portfolio.astro';
import Testimonials from '../components/Testimonials.astro';
import InkDivider from '../components/InkDivider.astro';

import logoSg from '../assets/brand/logo.png';
import oldSiteImg from '../assets/compare/old-site.png';
import afterImg from '../assets/compare/after.png';
import personBeforeImg from '../assets/compare/person-before.jpg';
import personAfterImg from '../assets/compare/person-after.jpg';

import {
  CALENDLY_URL,
  brand,
  nav,
  hero,
  vsl,
  identify,
  agitate,
  contrast,
  solution,
  outcomes,
  packages,
  usp,
  faq,
  urgency,
  finalCta,
  footer,
} from '../lib/site';

const pageTitle = `${brand.name} — ${brand.tagline}`;
const pageDesc =
  'Identitate vizuală premium pentru autori de cursuri. Te poziționăm ca alegerea evidentă, ca oamenii să vină deja convinși. Programează un apel de consultanță.';
---

<Base title={pageTitle} description={pageDesc}>
  <!-- ====================================================== NAV -->
  <header
    data-header
    class="fixed inset-x-0 top-0 z-50 overflow-hidden transition-all duration-500 ease-[var(--ease-out-expo)]"
  >
    <span class="header-flow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></span>
    <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:py-3.5">
      <a href="#top" class="relative z-[60] flex items-center" aria-label={`${brand.name} acasă`}>
        <Image src={logoSg} alt={brand.name} height={56} class="block h-11 w-auto sm:h-12" />
      </a>

      <div data-nav-menu class="nav-menu">
        {
          nav.links.map((l) => (
            <a href={l.href} class="nav-link">
              {l.label}
            </a>
          ))
        }
        <Button class="!px-5 !py-2.5 !text-sm" arrow={false}>{nav.cta}</Button>
      </div>

      <button
        data-nav-toggle
        type="button"
        aria-label="Deschide meniul"
        aria-expanded="false"
        class="nav-burger"
      >
        <span></span><span></span>
      </button>
    </nav>
  </header>

  <main id="main">
    <a id="top"></a>

    <!-- ====================================================== HERO (VSL-first) -->
    <section class="relative flex min-h-svh flex-col justify-center overflow-hidden pt-24 pb-12">
      <div data-studio-light="1.4" class="studio-light pointer-events-none absolute -right-32 -top-40 h-[40rem] w-[40rem] rounded-full bg-accent/25 blur-[120px]"></div>
      <div data-studio-light="-0.9" class="studio-light pointer-events-none absolute -left-40 top-1/3 h-[32rem] w-[32rem] rounded-full bg-accent/10 blur-[120px]" style="animation-delay:-2.6s"></div>
      <div class="reveal relative mx-auto w-full max-w-3xl px-5 text-center">
        <Eyebrow center>Studio de identitate vizuală</Eyebrow>
        <h1 class="display-1 hero-title mx-auto mt-5 max-w-2xl">
          <span class="line">{hero.headline[0]}</span>
          <span class="line">
            {hero.headline[1]}<span class="mark-word"
              >{hero.headline[2]}<svg viewBox="0 0 300 12" aria-hidden="true"
                ><path d="M4 8c52-5 132-7 220-5 26 .6 52 2 74 4" /></svg
              ></span>{hero.headline[3]}
          </span>
        </h1>

        <div class="mt-8">
          <VslPlayer />
        </div>

        <!-- CTA fix sub VSL (cerință) -->
        <div class="mt-7 flex flex-col items-center gap-3">
          <Button class="px-8 py-4 text-lg">{hero.cta}</Button>
          <p class="max-w-md text-sm text-muted">{vsl.microcopy}</p>
          <p class="text-sm font-medium text-ink-soft">{vsl.trust}</p>
        </div>
      </div>
    </section>

    <!-- ====================================================== LOGO MARQUEE -->
    <section class="on-dark bg-charcoal py-9 text-on-charcoal">
      <p class="mx-auto mb-6 max-w-6xl px-5 text-center text-xs font-medium uppercase tracking-[0.18em] text-on-charcoal/68">
        Branduri pentru care am lucrat
      </p>
      <Marquee />
    </section>

    <!-- ====================================================== IDENTIFY -->
    <section class="section">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="reveal">
          <Eyebrow>{identify.eyebrow}</Eyebrow>
          <h2 class="display-2 mt-4">{identify.title}</h2>
        </div>
        <div class="reveal">
          <p class="lede measure">{identify.intro}</p>
          <ul class="mt-8 grid">
            {
              identify.points.map((p, i) => (
                <li
                  data-reveal-child
                  class="reveal flex items-baseline gap-4 border-t border-line py-4 text-lg leading-snug text-ink-soft last:border-b"
                  style={`transition-delay:${i * 60}ms`}
                >
                  <span class="mt-[0.62em] h-px w-5 shrink-0 bg-accent"></span>
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-9 font-display text-[clamp(1.4rem,2.4vw,1.85rem)] font-semibold leading-snug text-ink">{identify.punch}</p>
        </div>
      </div>
    </section>

    <!-- ====================================================== AGITATE + DIPTYCH -->
    <section class="bg-surface section">
      <div class="mx-auto max-w-6xl px-5">
        <div class="reveal mx-auto max-w-2xl text-center">
          <Eyebrow center>{agitate.eyebrow}</Eyebrow>
          <h2 class="display-2 mt-4">{agitate.title}</h2>
          <p class="lede mt-5">{agitate.intro}</p>
        </div>

        <p class="reveal mt-12 text-center font-display text-[clamp(1.5rem,3.2vw,2.3rem)]">
          {agitate.question}
        </p>

        <!-- Row 1: people (perception in person) -->
        <div class="mt-8 grid gap-5 sm:grid-cols-2 sm:gap-8">
          <figure class="reveal">
            <div class="reveal-img relative overflow-hidden rounded-[18px]">
              <Image src={personBeforeImg} alt="Aceeași persoană, neîngrijită și fără direcție, lucrând improvizat" widths={[400, 700]} sizes="(max-width:640px) 100vw, 50vw" class="aspect-[3/4] w-full object-cover" loading="lazy" />
            </div>
            <figcaption class="mt-3 text-center font-display text-xl text-ink-soft">{agitate.personBefore}</figcaption>
          </figure>
          <figure class="reveal" style="transition-delay:110ms">
            <div class="reveal-img relative overflow-hidden rounded-[18px]">
              <Image src={personAfterImg} alt="Aceeași persoană, îngrijită și profesionistă, sigură pe ea" widths={[400, 700]} sizes="(max-width:640px) 100vw, 50vw" class="aspect-[3/4] w-full object-cover" loading="lazy" />
            </div>
            <figcaption class="mt-3 text-center font-display text-xl accent-ink">{agitate.personAfter}</figcaption>
          </figure>
        </div>

        <p class="reveal mx-auto mt-12 max-w-2xl text-center font-display text-[clamp(1.4rem,2.8vw,2rem)] leading-snug">
          {agitate.bridge}
        </p>

        <!-- Row 2: materials (perception online) -->
        <div class="mt-8 grid gap-5 sm:grid-cols-2 sm:gap-8">
          <figure class="reveal-img group overflow-hidden rounded-[18px]">
            <div class="relative overflow-hidden">
              <Image src={oldSiteImg} alt="Site aglomerat, multicolor, fără identitate vizuală coerentă" widths={[500, 900]} sizes="(max-width:640px) 100vw, 50vw" class="aspect-[16/11] w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.03]" loading="lazy" />
            </div>
            <figcaption class="flex items-center gap-2 bg-surface px-4 py-2.5 text-xs font-semibold uppercase tracking-[0.08em] text-muted">
              <span class="h-1.5 w-1.5 rounded-full bg-muted"></span>{agitate.beforeLabel}
            </figcaption>
          </figure>
          <figure class="reveal-img group overflow-hidden rounded-[18px]" style="transition-delay:110ms">
            <div class="relative overflow-hidden">
              <Image src={afterImg} alt="Site premium, clar și coerent, care inspiră încredere" widths={[500, 900]} sizes="(max-width:640px) 100vw, 50vw" class="aspect-[16/11] w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.03]" loading="lazy" />
            </div>
            <figcaption class="flex items-center gap-2 bg-accent px-4 py-2.5 text-xs font-semibold uppercase tracking-[0.08em] text-[oklch(0.99_0.001_285)]">
              <span class="h-1.5 w-1.5 rounded-full bg-[oklch(0.99_0.001_285)]"></span>{agitate.afterLabel}
            </figcaption>
          </figure>
        </div>

        <div class="reveal mt-12 grid gap-6 sm:grid-cols-3">
          {
            agitate.consequences.map((c) => (
              <p class="border-t border-line-strong pt-4 text-lg">
                <span class="font-display text-accent-strong">{c.k}</span>
                <span class="text-ink-soft"> {c.v}</span>
              </p>
            ))
          }
        </div>

        <p class="reveal mx-auto mt-12 max-w-3xl text-center font-display text-[clamp(1.5rem,3.4vw,2.4rem)] leading-[1.3]">
          {agitate.punch}
        </p>
      </div>
    </section>

    <!-- ====================================================== CONTRAST (drenched) -->
    <section class="on-dark bg-charcoal section text-on-charcoal">
      <div class="mx-auto max-w-6xl px-5">
        <div class="reveal mx-auto max-w-2xl text-center">
          <Eyebrow center dark>{contrast.eyebrow}</Eyebrow>
          <h2 class="display-2 mt-4 text-on-charcoal">{contrast.title}</h2>
        </div>

        <div class="reveal relative mt-14 grid gap-10 md:grid-cols-2 md:gap-16">
          <!-- vertical divider that draws on scroll (desktop) -->
          <svg class="absolute left-1/2 top-0 hidden h-full w-px -translate-x-1/2 md:block" preserveAspectRatio="none" viewBox="0 0 1 100" aria-hidden="true">
            <line x1="0.5" y1="0" x2="0.5" y2="100" pathLength="1" class="draw-line" stroke="oklch(0.97 0.002 285 / 0.18)" stroke-width="1" />
          </svg>

          <div class="md:pr-4">
            <p class="mb-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.14em] text-on-charcoal/68">
              {contrast.without.label}
            </p>
            <ul class="grid gap-5">
              {
                contrast.without.points.map((p) => (
                  <li class="flex items-start gap-3 text-on-charcoal/82">
                    <span class="mt-2.5 h-px w-4 shrink-0 bg-on-charcoal/35"></span>
                    <span>{p}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="md:pl-4">
            <p class="mb-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.14em] text-accent">
              {contrast.with.label}
            </p>
            <ul class="grid gap-5">
              {
                contrast.with.points.map((p) => (
                  <li class="flex items-start gap-3">
                    <svg class="mt-1 shrink-0 text-accent" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="text-on-charcoal">{p}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================== SOLUTION (lit block) -->
    <section class="solution-block section-lg relative overflow-hidden">
      <div class="relative mx-auto max-w-4xl px-5 text-center">
        <div class="reveal">
          <Eyebrow center>{solution.eyebrow}</Eyebrow>
          <h2 class="mt-5 font-display text-[clamp(2rem,5vw,3.6rem)] leading-[1.08]">{solution.title}</h2>
          <p class="lede mx-auto mt-7 max-w-2xl">{solution.body}</p>
          <p class="mt-8 text-sm uppercase tracking-[0.14em] text-accent-strong">{solution.signature}</p>
        </div>
      </div>
    </section>

    <InkDivider />

    <!-- ====================================================== PORTFOLIO -->
    <Portfolio />

    <!-- ====================================================== OUTCOMES -->
    <section class="section-tight">
      <div class="mx-auto max-w-6xl px-5">
        <div class="grid gap-x-16 gap-y-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
          <!-- left: section header (the single dominant title) -->
          <div class="reveal max-w-md">
            <Eyebrow>{outcomes.eyebrow}</Eyebrow>
            <h2 class="display-2 mt-4">{outcomes.title}</h2>
          </div>

          <!-- right: the anchor outcome, framed as a lead-in, not a rival headline -->
          <div class="reveal lg:border-l lg:border-line lg:pl-10" style="transition-delay:90ms">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent-strong">Primul lucru pe care îl simți</p>
            <p class="mt-4 font-display text-[clamp(1.4rem,2.2vw,1.85rem)] font-semibold leading-snug text-ink">
              {outcomes.items[0].t}.
            </p>
            <p class="mt-2 max-w-md text-ink-soft">{outcomes.items[0].d}</p>
          </div>
        </div>

        <!-- the rest: a tight, asymmetric editorial list, no decorative numbers -->
        <ul class="reveal mt-12 grid border-t border-line-strong sm:grid-cols-2 sm:gap-x-16">
          {
            outcomes.items.slice(1).map((o, i) => (
              <li
                data-reveal-child
                class="reveal group flex items-baseline gap-4 border-b border-line py-[1.15rem] last:border-b-0 sm:[&:nth-last-child(2)]:border-b-0"
                style={`transition-delay:${i * 55}ms`}
              >
                <span class="mt-[0.5em] h-px w-6 shrink-0 bg-accent-strong transition-[width] duration-500 ease-[var(--ease-out-expo)] group-hover:w-9"></span>
                <span class="flex-1">
                  <span class="font-display text-lg leading-snug">{o.t}.</span>
                  <span class="text-ink-soft"> {o.d}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ====================================================== PACKAGES -->
    <section id="pachete" class="bg-surface section">
      <div class="mx-auto max-w-6xl px-5">
        <div class="reveal mb-10 max-w-2xl">
          <Eyebrow>{packages.eyebrow}</Eyebrow>
          <h2 class="display-2 mt-4">{packages.title}</h2>
          <p class="mt-4 text-muted">{packages.note}</p>
        </div>

        <div class="grid items-stretch gap-6 lg:grid-cols-3">
          {
            packages.tiers.map((t, i) => (
              <article
                data-reveal-child
                class:list={[
                  'reveal flex flex-col rounded-[10px] p-7 transition-transform duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1.5',
                  t.featured
                    ? 'pkg-featured text-ink lg:-mt-4 lg:mb-[-1rem]'
                    : 'bg-surface ring-1 ring-line shadow-[var(--shadow-warm-sm)] hover:ring-accent/60',
                ]}
                style={`transition-delay:${i * 80}ms`}
              >
                <div class="flex items-center justify-between gap-3">
                  <h3 class="font-display text-2xl">{t.name}</h3>
                  {t.badge && (
                    <span class="rounded-full bg-accent px-3 py-1 text-xs font-semibold uppercase tracking-[0.1em] text-[oklch(0.99_0.001_285)]">
                      {t.badge}
                    </span>
                  )}
                </div>
                <p class:list={['mt-1 text-sm', t.featured ? 'text-ink-soft' : 'text-muted']}>
                  {t.tagline}
                </p>

                <div class="mt-5 flex items-end gap-2">
                  <span class:list={['font-display text-4xl', t.featured && 'text-accent-strong']}>{t.price}</span>
                  {t.oldPrice && <span class="pb-1 text-base text-muted line-through">{t.oldPrice}</span>}
                </div>
                <p class:list={['text-xs uppercase tracking-[0.12em]', t.featured ? 'text-ink-soft' : 'text-muted']}>
                  {t.cadence}
                </p>

                {/* features sit tight together; the empty space is pushed below via mt-auto on the CTA */}
                <ul class="mt-6 grid gap-3">
                  {t.features.map((f) => (
                    <li class="flex items-start gap-3 text-[0.95rem]">
                      <svg class:list={['mt-0.5 shrink-0', t.featured ? 'text-accent-strong' : 'text-accent']} width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span class:list={[t.featured ? 'text-ink' : 'text-ink-soft']}>{f}</span>
                    </li>
                  ))}
                </ul>

                {t.bonus && (
                  <p class:list={['mt-4 rounded-[8px] px-4 py-3 text-sm', t.featured ? 'bg-accent/12 text-ink-soft' : 'bg-surface-2 text-ink-soft']}>
                    {t.bonus}
                  </p>
                )}

                <div class="mt-auto pt-7">
                  <Button variant={t.featured ? 'primary' : 'outline'} class="w-full">{t.cta}</Button>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ====================================================== USP (manifest) -->
    <section class="section">
      <div class="mx-auto max-w-6xl px-5">
        <div class="reveal mb-10 max-w-3xl">
          <Eyebrow>{usp.eyebrow}</Eyebrow>
          <h2 class="display-2 mt-4">{usp.title}</h2>
        </div>
        <div class="reveal border-t border-line">
          {
            usp.items.map((u, i) => (
              <div
                data-reveal-child
                class="reveal group grid items-baseline gap-x-10 gap-y-1.5 border-b border-line py-7 md:grid-cols-[1.45fr_1fr]"
                style={`transition-delay:${i * 60}ms`}
              >
                <h3 class="font-display text-[clamp(1.5rem,3vw,2.15rem)] leading-[1.12] transition-colors duration-300 group-hover:text-accent-strong">
                  {u.t}
                </h3>
                <p class="text-ink-soft md:pt-2">{u.d}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <InkDivider flip />

    <!-- ====================================================== TESTIMONIALS -->
    <Testimonials />

    <!-- ====================================================== FAQ -->
    <section class="section">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="reveal">
          <Eyebrow>{faq.eyebrow}</Eyebrow>
          <h2 class="display-2 mt-4">{faq.title}</h2>
        </div>
        <div class="reveal">
          {
            faq.items.map((f) => (
              <details class="faq-item border-b border-line">
                <summary class="flex items-center justify-between gap-6 py-6">
                  <span class="font-display text-xl">{f.q}</span>
                  <span class="faq-plus grid h-8 w-8 shrink-0 place-items-center rounded-full ring-1 ring-line text-accent-strong">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                  </span>
                </summary>
                <div class="faq-panel">
                  <div>
                    <p class="measure pb-6 text-ink-soft">{f.a}</p>
                  </div>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ====================================================== URGENCY -->
    <section class="on-dark bg-charcoal-soft section text-on-charcoal">
      <div class="reveal mx-auto max-w-3xl px-5 text-center">
        <span class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-[oklch(0.97_0.002_285/0.16)] px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-on-charcoal/88">
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
          </span>
          {urgency.badge}
        </span>
        <h2 class="font-display text-[clamp(1.9rem,4vw,3rem)] leading-[1.08] text-on-charcoal">
          {urgency.title}
        </h2>
        <p class="lede mx-auto mt-5 max-w-xl text-on-charcoal/85">{urgency.body}</p>
        <div class="mt-8">
          <a
            href={CALENDLY_URL}
            data-calendly
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-flex items-center gap-2 text-accent"
          >
            {urgency.cta}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h13M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ====================================================== FINAL CTA (drenched) -->
    <section class="on-dark bg-charcoal section-lg text-on-charcoal">
      <div class="reveal mx-auto max-w-3xl px-5 text-center">
        <Eyebrow center dark>{finalCta.eyebrow}</Eyebrow>
        <h2 class="mt-5 font-display text-[clamp(2.1rem,5.5vw,4rem)] leading-[1.06] text-on-charcoal">
          {finalCta.title}
        </h2>
        <p class="lede mx-auto mt-7 max-w-2xl text-on-charcoal/88">{finalCta.body}</p>
        <div class="mt-9 flex justify-center">
          <Button class="px-9 py-4 text-lg">{finalCta.cta}</Button>
        </div>
        <ul class="mx-auto mt-9 flex max-w-2xl flex-wrap items-center justify-center gap-x-7 gap-y-3">
          {
            finalCta.guarantees.map((g) => (
              <li class="flex items-center gap-2 text-sm text-on-charcoal/82">
                <svg class="text-accent" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {g}
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <!-- ====================================================== FOOTER -->
  <footer class="bg-canvas pt-16 pb-10">
    <div class="mx-auto max-w-6xl px-5">
      <p class="reveal max-w-2xl font-display text-[clamp(1.4rem,2.6vw,2rem)] leading-snug">
        {footer.note}
      </p>

      <div class="mt-12 grid gap-10 border-t border-line pt-10 md:grid-cols-[1.5fr_1fr_1.2fr] md:gap-12">
        <!-- brand -->
        <div>
          <Image src={logoSg} alt={brand.name} height={64} class="h-12 w-auto" />
          <p class="mt-4 max-w-xs text-ink-soft">{brand.tagline}.</p>
          <div class="mt-6">
            <Button class="px-6 py-3" arrow={false}>{nav.cta}</Button>
          </div>
        </div>

        <!-- navigare -->
        <nav aria-label="Navigare footer">
          <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">Navigare</h3>
          <ul class="mt-4 grid gap-2.5">
            {
              nav.links.map((l) => (
                <li>
                  <a href={l.href} class="text-ink-soft transition-colors duration-300 hover:text-accent-strong">
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={CALENDLY_URL} data-calendly target="_blank" rel="noopener noreferrer" class="text-ink-soft transition-colors duration-300 hover:text-accent-strong">
                Programează apel
              </a>
            </li>
          </ul>
        </nav>

        <!-- contact -->
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">Contact</h3>
          <ul class="mt-4 grid gap-2.5">
            <li>
              <a href={`mailto:${brand.email}`} class="text-ink-soft transition-colors duration-300 hover:text-accent-strong">
                {brand.email}
              </a>
            </li>
            <li>
              <a href={`tel:${brand.phoneHref}`} class="text-ink-soft transition-colors duration-300 hover:text-accent-strong">
                {brand.phone}
              </a>
            </li>
            <li class="text-ink-soft">{brand.city}</li>
            <li class="pt-1 text-sm text-muted">Lucrăm exclusiv cu autori de cursuri și programe educaționale.</li>
          </ul>
        </div>
      </div>

      <div class="mt-10 flex flex-col gap-4 border-t border-line pt-6 text-sm text-muted md:flex-row md:items-center md:justify-between">
        <p>© {new Date().getFullYear()} {brand.name}. Toate drepturile rezervate.</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            footer.legal.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="link-underline"
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener noreferrer' : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </footer>
</Base>

